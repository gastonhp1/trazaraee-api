# Base de datos. En desarrollo alcanza con SQLite; en producción, Postgres.
DATABASE_URL=sqlite:///./trazaraee.db
# DATABASE_URL=postgresql+psycopg://trazaraee:trazaraee@localhost:5432/trazaraee

# Clave para crear estaciones (POST /stations). Generá una larga y aleatoria.
ADMIN_KEY=cambiame-por-una-clave-larga

# URL pública de la PWA: es lo que codifican los QR (https://app.ejemplo.org/a/<id>)
PUBLIC_BASE_URL=http://localhost:5173

# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# Fotos: carpeta donde se guardan, tamaño máximo por foto (bytes) y máximo por lote/equipo.
# En producción, montá PHOTOS_DIR en un volumen persistente y hacele backup junto con la base.
PHOTOS_DIR=./photos
# MAX_PHOTO_BYTES=8388608
# MAX_PHOTOS_PER_SUBJECT=30
